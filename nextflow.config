params {
    bucket = 'CHANGE-ME-bucket-name'
    reads = null
    reference = null
    outdir = null
}

profiles {
    awsbatch {
        process.executor = 'awsbatch'
        process.queue     = 'nf-variant-calling-queue'
        aws.region        = 'us-east-2'
        workDir           = "s3://${params.bucket}/work"
        params.reads      = params.reads ?: "s3://${params.bucket}/raw-fastq/*_R{1,2}.fastq.gz"
        params.reference  = params.reference ?: "s3://${params.bucket}/reference/chr21.fa"
        params.outdir     = params.outdir ?: "s3://${params.bucket}/results"

        // Use the simpler AWS CLI staging path instead of Fusion/Wave.
        // Point at a dedicated host path so Nextflow mounts only that helper
        // directory into the Batch containers.
        fusion.enabled = false
        wave.enabled   = false

        aws.batch.cliPath = '/opt/nextflow-bin/bin/aws'
    }

    local {
        process.executor = 'local'
        workDir           = './work'
        docker.enabled    = true
        params.reads      = params.reads ?: 'data/raw-fastq/*_R{1,2}.fastq.gz'
        params.reference  = params.reference ?: 'data/reference/chr21.fa'
        params.outdir     = params.outdir ?: 'results'
    }
}

// NOTE: resource requests below are sized to fit AWS Free Tier-eligible
// instances (m7i-flex.large = 2 vCPU / 8 GB). This is fine for the small
// chr21 test data. For production / whole-genome data, raise these (e.g.
// BWA_MEM 8 cpu / 16 GB) and use a paid AWS account plan with c5/r5 Spot
// instances — see docs/SUMMARY for the original sizing.
process {
    withName: FASTQC           { cpus = 2;  memory = '6 GB';  container = 'biocontainers/fastqc:v0.11.9_cv8' }
    withName: TRIM_GALORE      { cpus = 2;  memory = '6 GB';  container = 'quay.io/biocontainers/trim-galore:0.6.10--hdfd78af_0' }
    withName: BWA_MEM          { cpus = 2;  memory = '6 GB';  container = 'quay.io/biocontainers/bwa:0.7.17--h5bf99c6_8' }
    withName: SORT_DEDUP       { cpus = 2;  memory = '6 GB';  container = 'quay.io/biocontainers/samtools:1.19--h50ea8bc_0' }
    withName: HAPLOTYPE_CALLER { cpus = 2;  memory = '6 GB';  container = 'broadinstitute/gatk:4.5.0.0' }
}
